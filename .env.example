APP_NAME="Bombay Fashion"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bombay_fashion
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="care@bombayfashionamritsar.com"
MAIL_FROM_NAME="${APP_NAME}"

# Initial Admin Seeder Credentials
ADMIN_NAME="Owner - Bombay Fashion"
ADMIN_EMAIL="admin@bombayfashion.com"
ADMIN_PASSWORD="Admin@Bombay123!"

# Cloudinary Configuration (Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

# Razorpay Configuration
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Store Settings Defaults
STORE_NAME="Bombay Fashion"
STORE_PHONE="+91 98765 43210"
STORE_WHATSAPP="+919876543210"
STORE_ADDRESS="Mahila College Road, opposite Mahila College, Amritsar, Punjab, India"
STORE_TIMINGS="Open daily, closes 9:30 PM"

VITE_APP_NAME="${APP_NAME}"

